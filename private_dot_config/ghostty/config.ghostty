# ==============================================================================
# UNIFIED TERMINAL SHORTCUTS & BEHAVIORS (Ghostty, Kitty, Alacritty, WezTerm)
# ==============================================================================

# Clipboard & Copy-on-Select
copy-on-select = clipboard
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+insert=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection

# Select All
keybind = ctrl+shift+a=select_all

# Vim Mode / Scrollback in Editor
keybind = ctrl+shift+space=write_scrollback_file:open,plain
keybind = ctrl+shift+x=write_scrollback_file:open,plain

# Line Scrolling (Arrow keys & Vim keys)
keybind = ctrl+shift+up=scroll_page_lines:-1
keybind = ctrl+shift+down=scroll_page_lines:1
keybind = ctrl+shift+k=scroll_page_lines:-1
keybind = ctrl+shift+j=scroll_page_lines:1

# Page Scrolling
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down

# Scroll to Boundary
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom

# Search
keybind = ctrl+shift+f=start_search
