[general]
import = [
 "~/.config/alacritty/themes/github-dark.toml"
]

[window]
opacity = 0.80
blur = true
{{- if eq .chezmoi.os "darwin" }}
decorations = "buttonless"
option_as_alt = "Both"
{{- end }}

[font.normal]
family = "FiraCode Nerd Font"
style = "Regular"

[font.bold]
family = "FiraCode Nerd Font"
style = "Bold"

[font.italic]
family = "FiraCode Nerd Font"
style = "Italic"

[font.bold_italic]
family = "FiraCode Nerd Font"
style = "Bold Italic"

[font]
{{- if eq .chezmoi.os "darwin" }}
size = 14.0
{{- else }}
size = 11.5
{{- end }}
