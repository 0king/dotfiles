#!/usr/bin/env python3
"""
ai_view-ai-agents-history
=========================
Query, filter, and inspect commands executed by AI coding agents:
Kilo, Cline, Copilot, Antigravity, OpenCode, Aider, Pi, Dsh.

Default View:
  TIME (relative) | AGENT (colored) | DIR (last dir) | COMMAND (full formatted)

Short View (-s / --short):
  TIME (relative) | COMMAND (truncated to 300 chars)

Full Details View (-F / --full):
  ID, Timestamp, Agent, Full Directory, Formatted Command, Exit Code, Formatted Output.

Database location:
  ~/Desktop/fj/Dropbox/archives/backups/terminal/ai-agents-history/ai-agents-history.db
"""

import argparse
import csv
import glob
import io
import json
import os
import re
import shutil
import sqlite3
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

# --- ANSI Color Palette ---
COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
BOLD = "\033[1m" if COLOR else ""
DIM = "\033[2m" if COLOR else ""
RESET = "\033[0m" if COLOR else ""
RED = "\033[31m" if COLOR else ""
GREEN = "\033[32m" if COLOR else ""
YELLOW = "\033[33m" if COLOR else ""
BLUE = "\033[34m" if COLOR else ""
MAGENTA = "\033[35m" if COLOR else ""
CYAN = "\033[36m" if COLOR else ""
WHITE = "\033[37m" if COLOR else ""

AGENT_COLORS = {
    "antigravity": CYAN,
    "opencode": GREEN,
    "kilo": YELLOW,
    "cline": BLUE,
    "aider": MAGENTA,
    "copilot": WHITE,
    "pi": RED,
    "dsh": BOLD + BLUE,
}

DEFAULT_HISTORY_DIR = os.path.expanduser("~/Desktop/fj/Dropbox/archives/backups/terminal/ai-agents-history")
DEFAULT_DB_PATH = os.path.join(DEFAULT_HISTORY_DIR, "ai-agents-history.db")


def format_relative_time(ts_str):
    """Convert timestamp to relative time string (e.g. 15s ago, 2m ago, 1h ago, 1d ago, 1M ago, 1y ago)."""
    if not ts_str:
        return "-"
    now = datetime.now(timezone.utc)
    ts_clean = ts_str.replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(ts_clean)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
    except Exception:
        # Fallback to simple date extraction
        return ts_str[:10]

    diff = now - dt
    secs = int(diff.total_seconds())
    if secs < 0:
        secs = 0

    if secs < 60:
        return f"{secs}s ago"
    elif secs < 3600:
        return f"{secs // 60}m ago"
    elif secs < 86400:
        return f"{secs // 3600}h ago"
    elif secs < 86400 * 30:
        return f"{secs // 86400}d ago"
    elif secs < 86400 * 365:
        return f"{secs // (86400 * 30)}M ago"
    else:
        return f"{secs // (86400 * 365)}y ago"


def color_relative_time(rel_str, width=10):
    """Pad string first, then wrap with ANSI color code."""
    padded = f"{rel_str:<{width}}"
    if not COLOR:
        return padded
    if rel_str.endswith("s ago") or rel_str.endswith("m ago"):
        return f"{GREEN}{padded}{RESET}"
    elif rel_str.endswith("h ago"):
        return f"{CYAN}{padded}{RESET}"
    elif rel_str.endswith("d ago"):
        return f"{YELLOW}{padded}{RESET}"
    elif rel_str.endswith("M ago") or rel_str.endswith("y ago"):
        return f"{MAGENTA}{padded}{RESET}"
    return f"{DIM}{padded}{RESET}"


def format_agent_badge(agent_name, width=12):
    """Pad agent name first, then wrap with ANSI color code."""
    padded = f"{agent_name:<{width}}"
    if not COLOR:
        return padded
    color = AGENT_COLORS.get(agent_name.lower(), WHITE)
    return f"{color}{padded}{RESET}"


def format_rc(rc):
    """Format exit code."""
    if rc is None:
        return f"{DIM}-{RESET}"
    if rc == 0:
        return f"{GREEN}0{RESET}"
    return f"{RED}{rc}{RESET}"


def format_last_dir(path, width=14):
    """Get the last directory component of the full path."""
    if not path:
        res = "~"
    else:
        p = os.path.abspath(path.rstrip("/"))
        if p == os.path.expanduser("~"):
            res = "~"
        else:
            b = os.path.basename(p)
            res = b or "/"
    if len(res) > width:
        res = "…" + res[-(width - 1):]
    return f"{res:<{width}}"


def clean_command(cmd):
    """Unescape literal \\n to real newlines and strip surrounding whitespace/quotes."""
    if not cmd:
        return ""
    c = cmd.strip()
    if c.startswith('"') and c.endswith('"'):
        c = c[1:-1]
    # Replace literal \n with real newline
    return c.replace("\\\\n", "\n").replace("\\n", "\n").strip()


def clean_output(out):
    """Strip agent execution wrappers (Created At, Completed At, Command exited with code, Command output:, No output from the command.)."""
    if not out:
        return ""
    text = out.strip()
    
    # 1. Antigravity runner pattern: Command output:\n<real output>
    m = re.search(r"Command output:\s*\n?(.*)", text, re.DOTALL)
    if m:
        text = m.group(1).strip()
    else:
        # Strip header lines if present
        lines = text.splitlines()
        clean_lines = [
            l for l in lines 
            if not re.match(r"^(Created At:|Completed At:|Command exited with code)", l.strip())
        ]
        text = "\n".join(clean_lines).strip()

    if text in ("No output from the command.", "No output from the command"):
        text = ""

    return text


def parse_time_filter(time_str):
    """Parse relative or absolute time filter into an ISO-8601 string."""
    now = datetime.now(timezone.utc)
    s = time_str.lower().strip()
    if s == "today":
        return now.replace(hour=0, minute=0, second=0, microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ")
    if s == "yesterday":
        return (now - timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ")
    if s.endswith("h"):
        hours = int(s[:-1])
        return (now - timedelta(hours=hours)).strftime("%Y-%m-%dT%H:%M:%SZ")
    if s.endswith("d"):
        days = int(s[:-1])
        return (now - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    if s.endswith("m"):
        minutes = int(s[:-1])
        return (now - timedelta(minutes=minutes)).strftime("%Y-%m-%dT%H:%M:%SZ")
    return time_str


def extract_opencode_records(db_path, since_ms=None, source_label="sync"):
    """Extract commands from OpenCode database (supporting both v2 session_message and v1 part schemas)."""
    if not os.path.exists(db_path):
        return []
    records = []
    try:
        src = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = src.cursor()

        # 1. OpenCode V2 schema (session_message + session_v2)
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='session_message';")
        if cur.fetchone():
            time_filter = "AND sm.time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT sm.id, sm.session_id, sm.time_created, sm.data, sv.directory
                FROM session_message sm
                LEFT JOIN session_v2 sv ON sm.session_id = sv.id
                WHERE sm.type = 'assistant' {time_filter}
                ORDER BY sm.time_created ASC;
            """, params)
            for msg_id, sid, tc, data_str, sv_dir in cur.fetchall():
                try:
                    data = json.loads(data_str)
                    for item in data.get("content", []):
                        if item.get("type") == "tool" and item.get("name") in ("shell", "bash"):
                            state = item.get("state") or {}
                            inp = state.get("input") or {}
                            cmd = inp.get("command")
                            if not cmd or not cmd.strip():
                                continue
                            cwd = inp.get("workdir") or sv_dir or os.path.expanduser("~")
                            out_list = state.get("content") or []
                            out = "\n".join(c.get("text", "") for c in out_list if isinstance(c, dict) and "text" in c)
                            meta = state.get("metadata") or {}
                            rc = meta.get("exit")
                            if rc is None:
                                rc = 0 if state.get("status") == "completed" else 1
                            item_time = item.get("time", {}).get("created") or tc
                            ts = datetime.fromtimestamp(item_time / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                            records.append((ts, "opencode", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
                except Exception:
                    continue

        # 2. OpenCode V1 schema (part table)
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='part';")
        if cur.fetchone():
            time_filter = "AND time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT time_created, session_id,
                       json_extract(data, '$.state.input.command'),
                       json_extract(data, '$.state.input.workdir'),
                       json_extract(data, '$.state.output'),
                       json_extract(data, '$.state.status')
                FROM part
                WHERE json_extract(data, '$.type') = 'tool' AND json_extract(data, '$.tool') IN ('bash', 'shell')
                  {time_filter}
                ORDER BY time_created ASC;
            """, params)
            for tc, sid, cmd, workdir, out, status in cur.fetchall():
                if cmd and cmd.strip():
                    rc = 0 if status == "completed" else 1
                    ts = datetime.fromtimestamp(tc / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                    cwd = workdir or os.path.expanduser("~")
                    records.append((ts, "opencode", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
        src.close()
    except Exception:
        pass
    return records


def extract_kilo_records(db_path, since_ms=None, source_label="sync"):
    """Extract commands from Kilo database."""
    if not os.path.exists(db_path):
        return []
    records = []
    try:
        src = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = src.cursor()

        # 1. Kilo session_message
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='session_message';")
        if cur.fetchone():
            time_filter = "AND sm.time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT sm.id, sm.session_id, sm.time_created, sm.data
                FROM session_message sm
                WHERE sm.type = 'assistant' {time_filter}
                ORDER BY sm.time_created ASC;
            """, params)
            for msg_id, sid, tc, data_str in cur.fetchall():
                try:
                    data = json.loads(data_str)
                    for item in data.get("content", []):
                        if item.get("type") == "tool" and item.get("name") in ("shell", "bash"):
                            state = item.get("state") or {}
                            inp = state.get("input") or {}
                            cmd = inp.get("command")
                            if not cmd or not cmd.strip():
                                continue
                            cwd = inp.get("workdir") or os.path.expanduser("~")
                            out_list = state.get("content") or []
                            out = "\n".join(c.get("text", "") for c in out_list if isinstance(c, dict) and "text" in c)
                            meta = state.get("metadata") or {}
                            rc = meta.get("exit")
                            if rc is None:
                                rc = 0 if state.get("status") == "completed" else 1
                            item_time = item.get("time", {}).get("created") or tc
                            ts = datetime.fromtimestamp(item_time / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                            records.append((ts, "kilo", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
                except Exception:
                    continue

        # 2. Kilo part
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='part';")
        if cur.fetchone():
            time_filter = "AND time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT time_created, session_id,
                       json_extract(data, '$.state.input.command'),
                       json_extract(data, '$.state.input.workdir'),
                       json_extract(data, '$.state.output'),
                       json_extract(data, '$.state.status')
                FROM part
                WHERE json_extract(data, '$.type') = 'tool' AND json_extract(data, '$.tool') IN ('bash', 'shell')
                  {time_filter}
                ORDER BY time_created ASC;
            """, params)
            for tc, sid, cmd, workdir, out, status in cur.fetchall():
                if cmd and cmd.strip():
                    rc = 0 if status == "completed" else 1
                    ts = datetime.fromtimestamp(tc / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                    cwd = workdir or os.path.expanduser("~")
                    records.append((ts, "kilo", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
        src.close()
    except Exception:
        pass
    return records


def sync_recent_events(conn, window_seconds=7200):
    """Fast incremental sync of newly written agent commands (<25ms)."""
    now = time.time()
    records = []

    # 1. Antigravity transcripts
    brain_dir = os.path.expanduser("~/.gemini/antigravity/brain")
    recent_ag = [
        f for f in glob.glob(os.path.join(brain_dir, "*", ".system_generated", "logs", "transcript.jsonl"))
        if now - os.path.getmtime(f) < window_seconds
    ]
    for fpath in recent_ag:
        session_id = Path(fpath).parents[2].name
        try:
            with open(fpath, "r", encoding="utf-8", errors="replace") as fp:
                lines = [json.loads(l) for l in fp if l.strip()]
            for i, step in enumerate(lines):
                for tc in step.get("tool_calls") or []:
                    if tc.get("name") == "run_command":
                        args_tc = tc.get("args") or {}
                        raw_cmd = args_tc.get("CommandLine", "")
                        if raw_cmd.startswith('"') and raw_cmd.endswith('"'):
                            raw_cmd = raw_cmd[1:-1].replace('\\"', '"').replace('\\\\', '\\')
                        raw_cmd = raw_cmd.strip()
                        if not raw_cmd:
                            continue
                        ts = step.get("created_at") or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                        out = None
                        rc = 0
                        if i + 1 < len(lines):
                            content = lines[i + 1].get("content") or ""
                            if content:
                                out = clean_output(content[:65536])
                                m_rc = re.search(r"Command exited with code (\d+)", content)
                                if m_rc:
                                    rc = int(m_rc.group(1))
                        records.append((ts, "antigravity", os.path.expanduser("~"), raw_cmd, rc, out, session_id, "sync"))
        except Exception:
            continue

    # 2. OpenCode recent records
    oc_db = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if os.path.exists(oc_db) and (now - os.path.getmtime(oc_db) < window_seconds):
        records.extend(extract_opencode_records(oc_db, (now - window_seconds) * 1000, "sync"))

    # 3. Kilo recent records
    kilo_db = os.path.expanduser("~/.local/share/kilo/kilo.db")
    if os.path.exists(kilo_db) and (now - os.path.getmtime(kilo_db) < window_seconds):
        records.extend(extract_kilo_records(kilo_db, (now - window_seconds) * 1000, "sync"))

    if records:
        conn.executemany("""
            INSERT OR IGNORE INTO agent_commands 
            (timestamp, agent, cwd, command, exit_code, output, session_id, source)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, records)
        conn.commit()


def display_full_records(rows):
    """Display full details for matched records (-F / --full)."""
    for r in rows:
        _id, ts, agent, cwd, cmd, rc, out, sid = r
        clean_c = clean_command(cmd)
        clean_o = clean_output(out)
        agent_color = AGENT_COLORS.get(agent.lower(), WHITE)
        ts_clean = ts.replace("T", " ").replace("Z", "")[:19]
        rc_disp = format_rc(rc)

        print(f"\n{BOLD}{CYAN}=== [ID #{_id}] {ts_clean} | {agent_color}{agent.upper()}{RESET}{BOLD}{CYAN} | Exit: {rc_disp}{BOLD}{CYAN} ==={RESET}")
        print(f"{BOLD}Directory:{RESET} {cwd}")
        if sid:
            print(f"{BOLD}Session:{RESET}   {sid}")
        print(f"{BOLD}Command:{RESET}\n{clean_c}")
        if clean_o:
            print(f"{BOLD}Output:{RESET}\n{clean_o}")
    print()


def display_default_table(rows):
    """Display default compact table with relative time, agent, last directory, and human-readable full command."""
    term_width = shutil.get_terminal_size((120, 24)).columns
    time_w = 10
    agent_w = 12
    dir_w = 14
    indent = " " * (time_w + 1 + agent_w + 1 + dir_w + 1)

    print(f"\n{BOLD}{'TIME':<{time_w}} {'AGENT':<{agent_w}} {'DIR':<{dir_w}} {'COMMAND'}{RESET}")
    print(f"{DIM}{'-'*term_width}{RESET}")

    for row in rows:
        _id, ts, agent, cwd, cmd, rc, out, sid = row
        rel_time = format_relative_time(ts)
        time_badge = color_relative_time(rel_time, time_w)
        agent_badge = format_agent_badge(agent, agent_w)
        last_dir = format_last_dir(cwd, dir_w)
        clean_c = clean_command(cmd)

        cmd_lines = clean_c.splitlines() or [""]
        # Print first line aligned with columns
        print(f"{time_badge} {agent_badge} {last_dir} {cmd_lines[0]}")
        # Print subsequent lines indented to COMMAND column
        for l in cmd_lines[1:]:
            print(f"{indent}{l}")

    print(f"{DIM}{'-'*term_width}{RESET}")
    print(f"Showing {len(rows)} commands. (Use {CYAN}-s/--short{RESET} for short, {CYAN}-F/--full{RESET} for full, {CYAN}--stats{RESET} for analytics, {CYAN}-f{RESET} to follow)\n")


def display_short_table(rows):
    """Display short view: relative time and command truncated to 300 characters (-s / --short)."""
    term_width = shutil.get_terminal_size((120, 24)).columns
    time_w = 10
    indent = " " * (time_w + 1)

    print(f"\n{BOLD}{'TIME':<{time_w}} {'COMMAND'}{RESET}")
    print(f"{DIM}{'-'*term_width}{RESET}")

    for row in rows:
        _id, ts, agent, cwd, cmd, rc, out, sid = row
        rel_time = format_relative_time(ts)
        time_badge = color_relative_time(rel_time, time_w)
        clean_c = clean_command(cmd)
        if len(clean_c) > 300:
            clean_c = clean_c[:300] + "…"

        cmd_lines = clean_c.splitlines() or [""]
        print(f"{time_badge} {cmd_lines[0]}")
        for l in cmd_lines[1:]:
            print(f"{indent}{l}")

    print(f"{DIM}{'-'*term_width}{RESET}")
    print(f"Showing {len(rows)} commands. (Use {CYAN}-s/--short{RESET} for short, {CYAN}-F/--full{RESET} for full, {CYAN}--stats{RESET} for analytics, {CYAN}-f{RESET} to follow)\n")


def show_statistics(conn):
    """Display comprehensive analytics across AI agent commands."""
    cur = conn.cursor()
    cur.execute("SELECT count(*) FROM agent_commands;")
    total = cur.fetchone()[0]

    if total == 0:
        print(f"{YELLOW}No commands recorded yet.{RESET}")
        return

    print(f"\n{BOLD}{CYAN}=== AI Agents Command History Statistics ==={RESET}")
    print(f"Total Commands Recorded: {BOLD}{total:,}{RESET}\n")

    # 1. Agent breakdown & Error rate
    print(f"{BOLD}Agent Breakdown:{RESET}")
    print(f"  {'AGENT':<14} {'COUNT':>8} {'SHARE':>8} {'FAILED':>8} {'FAIL %':>8}")
    print(f"  {'-'*50}")
    cur.execute(
        """
        SELECT 
            agent, 
            count(*) as total_cmds,
            sum(CASE WHEN exit_code != 0 AND exit_code IS NOT NULL THEN 1 ELSE 0 END) as failed_cmds
        FROM agent_commands
        GROUP BY agent
        ORDER BY total_cmds DESC;
        """
    )
    for agent, cnt, failed in cur.fetchall():
        pct = (cnt / total * 100) if total else 0
        fail_pct = (failed / cnt * 100) if cnt else 0
        color = AGENT_COLORS.get(agent.lower(), WHITE)
        print(f"  {color}{agent:<14}{RESET} {BOLD}{cnt:>8,}{RESET} {pct:>7.1f}% {failed:>8,} {fail_pct:>7.1f}%")

    # 2. Top Working Directories
    print(f"\n{BOLD}Top Working Directories:{RESET}")
    cur.execute(
        """
        SELECT cwd, count(*) as cnt
        FROM agent_commands
        GROUP BY cwd
        ORDER BY cnt DESC
        LIMIT 5;
        """
    )
    for cwd, cnt in cur.fetchall():
        print(f"  {cnt:>6,}  {cwd}")

    # 3. Top Most Frequent Commands
    print(f"\n{BOLD}Most Frequent Commands:{RESET}")
    cur.execute(
        """
        SELECT command, count(*) as cnt
        FROM agent_commands
        GROUP BY command
        ORDER BY cnt DESC
        LIMIT 6;
        """
    )
    for cmd, cnt in cur.fetchall():
        one_liner = " ".join(cmd.splitlines())[:70]
        print(f"  {cnt:>6,}  {DIM}{one_liner}{RESET}")

    # 4. Activity breakdown: Today & Past 7 Days
    cur.execute(
        """
        SELECT count(*) FROM agent_commands
        WHERE timestamp >= date('now', 'start of day');
        """
    )
    today_cnt = cur.fetchone()[0]
    cur.execute(
        """
        SELECT count(*) FROM agent_commands
        WHERE timestamp >= datetime('now', '-7 days');
        """
    )
    week_cnt = cur.fetchone()[0]
    print(f"\n{BOLD}Activity Trends:{RESET}")
    print(f"  Today:        {BOLD}{today_cnt:,}{RESET} commands")
    print(f"  Past 7 days:  {BOLD}{week_cnt:,}{RESET} commands\n")


def follow_mode(conn, args):
    """Continuously poll and print new incoming agent commands."""
    print(f"{CYAN}{BOLD}Streaming AI agent commands in real-time... (Press Ctrl+C to exit){RESET}\n")
    cur = conn.cursor()
    cur.execute("SELECT ifnull(max(id), 0) FROM agent_commands;")
    last_id = cur.fetchone()[0]

    try:
        while True:
            if not getattr(args, "no_sync", False):
                try:
                    sync_recent_events(conn, window_seconds=120)
                except Exception:
                    pass

            cur.execute(
                """
                SELECT id, timestamp, agent, cwd, command, exit_code, output, session_id
                FROM agent_commands
                WHERE id > ?
                ORDER BY id ASC;
                """,
                (last_id,),
            )
            rows = cur.fetchall()
            if rows:
                if args.full:
                    display_full_records(rows)
                elif args.short:
                    for row in rows:
                        _id, ts, agent, cwd, cmd, rc, out, sid = row
                        last_id = _id
                        rel_time = format_relative_time(ts)
                        time_b = color_relative_time(rel_time, 10)
                        clean_c = clean_command(cmd)
                        if len(clean_c) > 300:
                            clean_c = clean_c[:300] + "…"
                        indent = " " * 11
                        lines = clean_c.splitlines() or [""]
                        print(f"{time_b} {lines[0]}")
                        for l in lines[1:]:
                            print(f"{indent}{l}")
                else:
                    for row in rows:
                        _id, ts, agent, cwd, cmd, rc, out, sid = row
                        last_id = _id
                        rel_time = format_relative_time(ts)
                        time_b = color_relative_time(rel_time, 10)
                        agent_b = format_agent_badge(agent, 12)
                        last_d = format_last_dir(cwd, 14)
                        clean_c = clean_command(cmd)
                        indent = " " * (10 + 1 + 12 + 1 + 14 + 1)
                        lines = clean_c.splitlines() or [""]
                        print(f"{time_b} {agent_b} {last_d} {lines[0]}")
                        for l in lines[1:]:
                            print(f"{indent}{l}")
            time.sleep(1.0)
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Stopped streaming.{RESET}")


def main():
    parser = argparse.ArgumentParser(
        description="Query, filter, and inspect AI coding agents command history.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("query", nargs="?", default="", help="Search query in command string")
    parser.add_argument("-n", "--limit", type=int, default=25, help="Number of records to show (default: 25, 0 for all)")
    parser.add_argument("-s", "--short", action="store_true", help="Display short view: relative time and command (truncated to 300 chars)")
    parser.add_argument("-F", "--full", action="store_true", help="Display full details (ID, timestamp, agent, full directory path, formatted full command, exit code, formatted output)")
    parser.add_argument("-a", "--agent", help="Filter by agent (kilo, cline, copilot, antigravity, opencode, aider, pi, dsh)")
    parser.add_argument("-q", "--search", "--query", dest="search", help="Search query (alternative to positional argument)")
    parser.add_argument("-d", "--dir", "--cwd", dest="cwd", help="Filter by working directory")
    parser.add_argument("-e", "--failed", "--errors", action="store_true", help="Show only failed commands (exit_code != 0)")
    parser.add_argument("--since", help="Filter commands after datetime (e.g. 'today', 'yesterday', '1h', '7d', '2026-10-29')")
    parser.add_argument("--until", help="Filter commands before datetime")
    parser.add_argument("-i", "--id", type=int, help="Show complete details for a specific command ID")
    parser.add_argument("--stats", action="store_true", help="Show summary statistics and analytics")
    parser.add_argument("-f", "--follow", action="store_true", help="Live stream new commands in real-time")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    parser.add_argument("--csv", action="store_true", help="Output results in CSV format")
    parser.add_argument("--no-sync", action="store_true", help="Skip automatic fast sync of recent commands")
    parser.add_argument("--db", default=DEFAULT_DB_PATH, help=f"Path to SQLite database (default: {DEFAULT_DB_PATH})")

    args = parser.parse_args()

    if not os.path.exists(args.db):
        print(f"{YELLOW}AI command history database not found at:{RESET} {args.db}")
        print(f"Run {BOLD}ai_create-ai-agents-history-hook --install{RESET} to initialize and backfill history.")
        sys.exit(1)

    conn = sqlite3.connect(args.db)

    # Automatic fast sync of newly executed commands (<25ms)
    if not args.no_sync:
        try:
            sync_recent_events(conn)
        except Exception:
            pass

    # 1. Single record detail mode
    if args.id:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT id, timestamp, agent, cwd, command, exit_code, output, session_id
            FROM agent_commands
            WHERE id = ?;
            """,
            (args.id,),
        )
        row = cur.fetchone()
        if not row:
            print(f"{RED}Error: Record with ID {args.id} not found.{RESET}")
        else:
            display_full_records([row])
        conn.close()
        return

    # 2. Statistics mode
    if args.stats:
        show_statistics(conn)
        conn.close()
        return

    # 3. Follow live mode
    if args.follow:
        follow_mode(conn, args)
        conn.close()
        return

    # 4. Standard query mode
    conditions = []
    params = []

    search_term = args.search or args.query
    if search_term:
        conditions.append("command LIKE ?")
        params.append(f"%{search_term}%")

    if args.agent:
        conditions.append("agent = ?")
        params.append(args.agent.lower())

    if args.cwd:
        conditions.append("cwd LIKE ?")
        params.append(f"%{args.cwd}%")

    if args.failed:
        conditions.append("exit_code != 0 AND exit_code IS NOT NULL")

    if args.since:
        conditions.append("timestamp >= ?")
        params.append(parse_time_filter(args.since))

    if args.until:
        conditions.append("timestamp <= ?")
        params.append(parse_time_filter(args.until))

    where_clause = f"WHERE {' AND '.join(conditions)}" if conditions else ""
    limit_clause = f"LIMIT {args.limit}" if args.limit and args.limit > 0 else ""

    sql = f"""
        SELECT id, timestamp, agent, cwd, command, exit_code, output, session_id
        FROM agent_commands
        {where_clause}
        ORDER BY timestamp DESC, id DESC
        {limit_clause};
    """

    cur = conn.cursor()
    cur.execute(sql, params)
    rows = cur.fetchall()

    if args.json:
        records = []
        for r in rows:
            records.append({
                "id": r[0],
                "timestamp": r[1],
                "agent": r[2],
                "cwd": r[3],
                "command": clean_command(r[4]),
                "exit_code": r[5],
                "output": clean_output(r[6]),
                "session_id": r[7],
            })
        print(json.dumps(records, indent=2))
        conn.close()
        return

    if args.csv:
        writer = csv.writer(sys.stdout)
        writer.writerow(["id", "timestamp", "agent", "cwd", "command", "exit_code", "output", "session_id"])
        for r in rows:
            writer.writerow([r[0], r[1], r[2], r[3], clean_command(r[4]), r[5], clean_output(r[6]), r[7]])
        conn.close()
        return

    if not rows:
        print(f"{DIM}No matching commands found.{RESET}")
        conn.close()
        return

    # Check display mode
    if args.full:
        display_full_records(rows)
    elif args.short:
        display_short_table(rows)
    else:
        display_default_table(rows)

    conn.close()


if __name__ == "__main__":
    main()
