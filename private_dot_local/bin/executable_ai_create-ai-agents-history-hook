#!/usr/bin/env python3
"""
ai_create-ai-agents-history-hook
================================
Management, installer, and backfill utility for the AI Agents Command History System.
Supports: Kilo, Cline, Copilot, Antigravity, OpenCode, Aider, Pi, Dsh.

Database location:
  ~/Desktop/fj/Dropbox/archives/backups/terminal/ai-agents-history/ai-agents-history.db
"""

import argparse
import glob
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

# --- ANSI Color Palette ---
COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
BOLD = "\033[1m" if COLOR else ""
DIM = "\033[2m" if COLOR else ""
RESET = "\033[0m" if COLOR else ""
RED = "\033[31m" if COLOR else ""
GREEN = "\033[32m" if COLOR else ""
YELLOW = "\033[33m" if COLOR else ""
BLUE = "\033[34m" if COLOR else ""
MAGENTA = "\033[35m" if COLOR else ""
CYAN = "\033[36m" if COLOR else ""
WHITE = "\033[37m" if COLOR else ""

DEFAULT_HISTORY_DIR = os.path.expanduser("~/Desktop/fj/Dropbox/archives/backups/terminal/ai-agents-history")
DEFAULT_DB_PATH = os.path.join(DEFAULT_HISTORY_DIR, "ai-agents-history.db")
HOOK_SCRIPT_PATH = os.path.expanduser("~/.config/ai/hooks/ai-agents-bash-hook.sh")

SCHEMA = """
CREATE TABLE IF NOT EXISTS agent_commands (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT NOT NULL,
    agent TEXT NOT NULL,
    cwd TEXT NOT NULL,
    command TEXT NOT NULL,
    exit_code INTEGER,
    output TEXT,
    session_id TEXT,
    source TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now', 'localtime')),
    UNIQUE(timestamp, agent, cwd, command) ON CONFLICT IGNORE
);
CREATE INDEX IF NOT EXISTS idx_cmd_timestamp ON agent_commands(timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_cmd_agent ON agent_commands(agent);
CREATE INDEX IF NOT EXISTS idx_cmd_cwd ON agent_commands(cwd);
CREATE INDEX IF NOT EXISTS idx_cmd_exit ON agent_commands(exit_code);
"""


def get_db_connection(db_path=DEFAULT_DB_PATH):
    os.makedirs(os.path.dirname(db_path), exist_ok=True)
    conn = sqlite3.connect(db_path, timeout=10.0)
    conn.execute("PRAGMA journal_mode = WAL;")
    conn.execute("PRAGMA busy_timeout = 5000;")
    conn.execute("PRAGMA synchronous = NORMAL;")
    conn.executescript(SCHEMA)
    return conn


def cmd_record(args):
    """Record a single command entry into SQLite."""
    db_path = args.db or DEFAULT_DB_PATH
    ts = args.timestamp or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    conn = get_db_connection(db_path)
    try:
        conn.execute(
            """
            INSERT OR IGNORE INTO agent_commands 
            (timestamp, agent, cwd, command, exit_code, output, session_id, source)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                ts,
                args.agent.lower(),
                args.cwd or os.getcwd(),
                args.command.strip(),
                args.exit_code,
                (args.output or "")[:65536] if args.output else None,
                args.session_id,
                args.source or "hook",
            ),
        )
        conn.commit()
    except Exception as e:
        sys.stderr.write(f"Record error: {e}\n")
    finally:
        conn.close()


def clean_output(out):
    """Strip agent execution wrappers (Created At, Completed At, Command exited with code, Command output:, No output from the command.)."""
    if not out:
        return ""
    text = out.strip()
    
    # Antigravity runner pattern: Command output:\n<real output>
    m = re.search(r"Command output:\s*\n?(.*)", text, re.DOTALL)
    if m:
        text = m.group(1).strip()
    else:
        # Strip header / status lines if present
        lines = text.splitlines()
        clean_lines = [
            l for l in lines 
            if not re.match(r"^(Created At:|Completed At:|Command exited with code)", l.strip())
        ]
        text = "\n".join(clean_lines).strip()

    if text in ("No output from the command.", "No output from the command"):
        text = ""

    return text


def extract_opencode_records(db_path, since_ms=None, source_label="sync"):
    """Extract commands from OpenCode database (supporting both v2 session_message and v1 part schemas)."""
    if not os.path.exists(db_path):
        return []
    records = []
    try:
        src = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = src.cursor()

        # 1. OpenCode V2 schema (session_message + session_v2)
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='session_message';")
        if cur.fetchone():
            time_filter = "AND sm.time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT sm.id, sm.session_id, sm.time_created, sm.data, sv.directory
                FROM session_message sm
                LEFT JOIN session_v2 sv ON sm.session_id = sv.id
                WHERE sm.type = 'assistant' {time_filter}
                ORDER BY sm.time_created ASC;
            """, params)
            for msg_id, sid, tc, data_str, sv_dir in cur.fetchall():
                try:
                    data = json.loads(data_str)
                    for item in data.get("content", []):
                        if item.get("type") == "tool" and item.get("name") in ("shell", "bash"):
                            state = item.get("state") or {}
                            inp = state.get("input") or {}
                            cmd = inp.get("command")
                            if not cmd or not cmd.strip():
                                continue
                            cwd = inp.get("workdir") or sv_dir or os.path.expanduser("~")
                            out_list = state.get("content") or []
                            out = "\n".join(c.get("text", "") for c in out_list if isinstance(c, dict) and "text" in c)
                            meta = state.get("metadata") or {}
                            rc = meta.get("exit")
                            if rc is None:
                                rc = 0 if state.get("status") == "completed" else 1
                            item_time = item.get("time", {}).get("created") or tc
                            ts = datetime.fromtimestamp(item_time / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                            records.append((ts, "opencode", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
                except Exception:
                    continue

        # 2. OpenCode V1 schema (part table)
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='part';")
        if cur.fetchone():
            time_filter = "AND time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT time_created, session_id,
                       json_extract(data, '$.state.input.command'),
                       json_extract(data, '$.state.input.workdir'),
                       json_extract(data, '$.state.output'),
                       json_extract(data, '$.state.status')
                FROM part
                WHERE json_extract(data, '$.type') = 'tool' AND json_extract(data, '$.tool') IN ('bash', 'shell')
                  {time_filter}
                ORDER BY time_created ASC;
            """, params)
            for tc, sid, cmd, workdir, out, status in cur.fetchall():
                if cmd and cmd.strip():
                    rc = 0 if status == "completed" else 1
                    ts = datetime.fromtimestamp(tc / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                    cwd = workdir or os.path.expanduser("~")
                    records.append((ts, "opencode", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
        src.close()
    except Exception:
        pass
    return records


def extract_kilo_records(db_path, since_ms=None, source_label="sync"):
    """Extract commands from Kilo database."""
    if not os.path.exists(db_path):
        return []
    records = []
    try:
        src = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = src.cursor()

        # 1. Kilo session_message
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='session_message';")
        if cur.fetchone():
            time_filter = "AND sm.time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT sm.id, sm.session_id, sm.time_created, sm.data
                FROM session_message sm
                WHERE sm.type = 'assistant' {time_filter}
                ORDER BY sm.time_created ASC;
            """, params)
            for msg_id, sid, tc, data_str in cur.fetchall():
                try:
                    data = json.loads(data_str)
                    for item in data.get("content", []):
                        if item.get("type") == "tool" and item.get("name") in ("shell", "bash"):
                            state = item.get("state") or {}
                            inp = state.get("input") or {}
                            cmd = inp.get("command")
                            if not cmd or not cmd.strip():
                                continue
                            cwd = inp.get("workdir") or os.path.expanduser("~")
                            out_list = state.get("content") or []
                            out = "\n".join(c.get("text", "") for c in out_list if isinstance(c, dict) and "text" in c)
                            meta = state.get("metadata") or {}
                            rc = meta.get("exit")
                            if rc is None:
                                rc = 0 if state.get("status") == "completed" else 1
                            item_time = item.get("time", {}).get("created") or tc
                            ts = datetime.fromtimestamp(item_time / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                            records.append((ts, "kilo", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
                except Exception:
                    continue

        # 2. Kilo part
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='part';")
        if cur.fetchone():
            time_filter = "AND time_created >= ?" if since_ms else ""
            params = (since_ms,) if since_ms else ()
            cur.execute(f"""
                SELECT time_created, session_id,
                       json_extract(data, '$.state.input.command'),
                       json_extract(data, '$.state.input.workdir'),
                       json_extract(data, '$.state.output'),
                       json_extract(data, '$.state.status')
                FROM part
                WHERE json_extract(data, '$.type') = 'tool' AND json_extract(data, '$.tool') IN ('bash', 'shell')
                  {time_filter}
                ORDER BY time_created ASC;
            """, params)
            for tc, sid, cmd, workdir, out, status in cur.fetchall():
                if cmd and cmd.strip():
                    rc = 0 if status == "completed" else 1
                    ts = datetime.fromtimestamp(tc / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                    cwd = workdir or os.path.expanduser("~")
                    records.append((ts, "kilo", cwd, cmd.strip(), rc, clean_output(out[:65536]) if out else None, sid, source_label))
        src.close()
    except Exception:
        pass
    return records


def backfill_antigravity(conn):
    """Extract commands from Antigravity session transcripts."""
    print(f"  {CYAN}▸{RESET} Scanning Antigravity transcripts...")
    brain_dir = os.path.expanduser("~/.gemini/antigravity/brain")
    transcript_files = glob.glob(os.path.join(brain_dir, "*", ".system_generated", "logs", "transcript.jsonl"))
    
    records = []
    for fpath in transcript_files:
        session_id = Path(fpath).parents[2].name
        try:
            with open(fpath, "r", encoding="utf-8", errors="replace") as f:
                lines = [json.loads(line) for line in f if line.strip()]
            for i, step in enumerate(lines):
                tool_calls = step.get("tool_calls") or []
                for tc in tool_calls:
                    if tc.get("name") == "run_command":
                        args = tc.get("args") or {}
                        raw_cmd = args.get("CommandLine", "")
                        if raw_cmd.startswith('"') and raw_cmd.endswith('"'):
                            raw_cmd = raw_cmd[1:-1].replace('\\"', '"').replace('\\\\', '\\')
                        raw_cmd = raw_cmd.strip()
                        if not raw_cmd:
                            continue
                        
                        ts = step.get("created_at") or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                        # Try to capture output from subsequent tool result step
                        out = None
                        rc = 0
                        if i + 1 < len(lines):
                            next_step = lines[i + 1]
                            content = next_step.get("content") or ""
                            if content:
                                out = clean_output(content[:65536])
                                m_rc = re.search(r"Command exited with code (\d+)", content)
                                if m_rc:
                                    rc = int(m_rc.group(1))
                        
                        records.append((ts, "antigravity", os.path.expanduser("~"), raw_cmd, rc, out, session_id, "backfill"))
        except Exception:
            continue

    if records:
        conn.executemany(
            """
            INSERT OR IGNORE INTO agent_commands 
            (timestamp, agent, cwd, command, exit_code, output, session_id, source)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            records,
        )
        conn.commit()
    print(f"    {GREEN}✓{RESET} Found and processed {len(records)} Antigravity commands")
    return len(records)


def backfill_opencode(conn):
    """Extract commands from OpenCode database (both v2 session_message and v1 part schemas)."""
    print(f"  {CYAN}▸{RESET} Scanning OpenCode SQLite database...")
    db_file = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if not os.path.exists(db_file):
        print(f"    {DIM}OpenCode database not found. Skipping.{RESET}")
        return 0

    records = extract_opencode_records(db_file, since_ms=None, source_label="backfill")

    if records:
        conn.executemany(
            """
            INSERT OR IGNORE INTO agent_commands 
            (timestamp, agent, cwd, command, exit_code, output, session_id, source)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            records,
        )
        conn.commit()
    print(f"    {GREEN}✓{RESET} Found and processed {len(records)} OpenCode commands")
    return len(records)


