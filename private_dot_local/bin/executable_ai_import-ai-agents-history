EXTRACTORS = {
    "antigravity": AntigravityExtractor,
    "opencode": OpenCodeExtractor,
    "kilo": KiloExtractor,
    "cline": ClineExtractor,
    "aider": AiderExtractor,
    "copilot": CopilotExtractor,
    "pi": PiExtractor,
    "dsh": DshExtractor,
}


# ── Main Import Runner ────────────────────────────────────────────────────────

def run_import(db_path=DEFAULT_DB_PATH, since_iso=None, target_agents=None, quiet=False):
    """Import new commands into SQLite database with conflict avoidance."""
    start_time = time.time()
    conn = get_db_connection(db_path)

    cur = conn.cursor()
    cur.execute("SELECT count(*) FROM agent_commands;")
    before_count = cur.fetchone()[0]

    selected_agents = target_agents or list(EXTRACTORS.keys())
    if not quiet:
        print(f"\n{BOLD}{CYAN}=== AI Agents Command History Import ==={RESET}")
        print(f"Database: {BOLD}{db_path}{RESET}")
        if since_iso:
            print(f"Window:   {BOLD}Since {since_iso}{RESET}")
        else:
            print(f"Window:   {BOLD}All available history (full backfill){RESET}")
        print()

    all_records = []
    for agent_name in selected_agents:
        extractor = EXTRACTORS.get(agent_name.lower())
        if extractor:
            try:
                records = extractor.extract(since_iso=since_iso, quiet=quiet)
                all_records.extend(records)
            except Exception as e:
                if not quiet:
                    print(f"    {RED}! Error extracting from {agent_name}: {e}{RESET}")

    if all_records:
        conn.executemany(
            """
            INSERT OR IGNORE INTO agent_commands 
            (timestamp, agent, cwd, command, exit_code, output, session_id, source)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            all_records,
        )
        conn.commit()

    cur.execute("SELECT count(*) FROM agent_commands;")
    after_count = cur.fetchone()[0]
    conn.close()

    newly_added = after_count - before_count
    elapsed = time.time() - start_time

    if not quiet:
        print(f"\n{GREEN}{BOLD}✓ Import complete in {elapsed:.2f}s!{RESET}")
        print(f"  Processed:    {BOLD}{len(all_records):,}{RESET} candidates")
        print(f"  Newly added:  {GREEN}{BOLD}{newly_added:,}{RESET} commands")
        print(f"  Total in DB:  {BOLD}{after_count:,}{RESET} commands\n")

    return {
        "processed": len(all_records),
        "added": newly_added,
        "total": after_count,
        "elapsed": elapsed,
    }


def main():
    parser = argparse.ArgumentParser(
        description="Import commands from AI coding agents (Antigravity, OpenCode, Kilo, Cline, Copilot, Aider, Pi, Dsh) into SQLite.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--since",
        help="Import commands executed since a relative or absolute time (e.g. '2h', '24h', '7d', 'today', '2026-10-31'). Default: 2h for on-demand sync.",
    )
    parser.add_argument(
        "--all", "--backfill",
        dest="all_history",
        action="store_true",
        help="Scan and import all historical logs from day zero (full backfill).",
    )
    parser.add_argument(
        "-a", "--agent",
        help="Import for specific agent only (antigravity, opencode, kilo, cline, aider, copilot, pi, dsh).",
    )
    parser.add_argument(
        "-q", "--quiet",
        action="store_true",
        help="Quiet mode for cron execution (no stdout, only errors to stderr).",
    )
    parser.add_argument(
        "--stats",
        action="store_true",
        help="Print summary statistics after importing.",
    )
    parser.add_argument(
        "--db",
        default=DEFAULT_DB_PATH,
        help=f"Path to SQLite database (default: {DEFAULT_DB_PATH}).",
    )

    args = parser.parse_args()

    # Determine time window
    if args.all_history:
        since_iso = None
    elif args.since:
        since_iso = parse_time_filter(args.since)
    else:
        # Default on-demand sync window: last 2 hours
        since_iso = (datetime.now(timezone.utc) - timedelta(hours=2)).strftime("%Y-%m-%dT%H:%M:%SZ")

    target_agents = [args.agent.lower()] if args.agent else None

    result = run_import(
        db_path=args.db,
        since_iso=since_iso,
        target_agents=target_agents,
        quiet=args.quiet,
    )

    if args.stats and args.quiet:
        print(f"Added {result['added']} commands (Total: {result['total']}) in {result['elapsed']:.2f}s")


if __name__ == "__main__":
    main()
