#!/usr/bin/env bash
#
# ai_cron-ai-agents-history
# =========================
# Hourly cron orchestrator for AI coding agents command history import.
# Runs import with lock protection, failure alerts, and manages
# hourly systemd user timer and crontab schedules.
#
# Usage:
#   ai_cron-ai-agents-history [run]       # Run hourly import (default)
#   ai_cron-ai-agents-history --status    # Check schedule and timer status
#   ai_cron-ai-agents-history --install   # Install & start hourly systemd timer
#   ai_cron-ai-agents-history --install-timer
#   ai_cron-ai-agents-history --install-cron
#   ai_cron-ai-agents-history --uninstall
#

set -euo pipefail

# --- ANSI Color Palette ---
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  RESET=$'\033[0m'
  RED=$'\033[31m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  CYAN=$'\033[36m'
else
  BOLD=""
  DIM=""
  RESET=""
  RED=""
  GREEN=""
  YELLOW=""
  CYAN=""
fi

log_info()    { printf "%s[INFO]%s  %s\n" "$CYAN" "$RESET" "$*"; }
log_success() { printf "%s[OK]%s    %s\n" "$GREEN" "$RESET" "$*"; }
log_warn()    { printf "%s[WARN]%s  %s\n" "$YELLOW" "$RESET" "$*" >&2; }
log_error()   { printf "%s[ERROR]%s %s\n" "$RED" "$RESET" "$*" >&2; }

# Paths & Defaults
DEFAULT_HISTORY_DIR="${HOME}/Desktop/fj/Dropbox/archives/backups/terminal/ai-agents-history"
LOG_FILE="${DEFAULT_HISTORY_DIR}/ai-agents-history-cron.log"
LOCK_FILE="/tmp/ai-agents-history-cron.lock"
IMPORTER_BIN="${HOME}/.local/bin/ai_import-ai-agents-history"

TIMER_NAME="ai-agents-history-import.timer"
SERVICE_NAME="ai-agents-history-import.service"
SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"

# Desktop Notification on Failure
notify_failure() {
  local msg="$1"
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${UID:-}" ]; then
    local bus="/run/user/${UID}/bus"
    [ -S "$bus" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}"
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send \
      -u critical \
      -a "AI History Import" \
      -i "dialog-error" \
      "AI History Import Failed" \
      "$msg" 2>/dev/null || true
  fi
}

# ── Command: run ──────────────────────────────────────────────────────────────
cmd_run() {
  mkdir -p "$DEFAULT_HISTORY_DIR"

  # Acquire lock non-blockingly to avoid overlapping cron runs
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log_warn "Another import process is already running. Skipping."
    exit 0
  fi

  local ts
  ts=$(date "+%Y-%m-%d %H:%M:%S")

  if [ ! -x "$IMPORTER_BIN" ]; then
    local err="Importer executable not found at $IMPORTER_BIN"
    log_error "$err"
    notify_failure "$err"
    echo "[$ts] ERROR: $err" >> "$LOG_FILE"
    exit 1
  fi

  # Run import for recent 2 hours quietly
  if "$IMPORTER_BIN" --since 2h --quiet; then
    echo "[$ts] SUCCESS: Hourly import completed." >> "$LOG_FILE"
  else
    local rc=$?
    local err="ai_import-ai-agents-history failed with exit code $rc"
    log_error "$err"
    notify_failure "$err"
    echo "[$ts] ERROR: $err" >> "$LOG_FILE"
    exit $rc
  fi
}

# ── Command: install-timer (systemd user timer) ────────────────────────────────
cmd_install_timer() {
  mkdir -p "$SYSTEMD_USER_DIR"
  log_info "Configuring systemd user service and timer..."

  cat > "${SYSTEMD_USER_DIR}/${SERVICE_NAME}" <<EOF
[Unit]
Description=Hourly Import of AI Coding Agents Command History
Documentation=file://%h/.local/bin/ai_import-ai-agents-history

[Service]
Type=oneshot
ExecStart=%h/.local/bin/ai_cron-ai-agents-history run
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
EOF

  cat > "${SYSTEMD_USER_DIR}/${TIMER_NAME}" <<EOF
[Unit]
Description=Hourly Timer for AI Coding Agents Command History Import
Documentation=file://%h/.local/bin/ai_cron-ai-agents-history

[Timer]
OnCalendar=*:00:00
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now "$TIMER_NAME"
  log_success "Systemd user timer '$TIMER_NAME' installed and started successfully!"
}

# ── Command: install-cron (crontab entry) ──────────────────────────────────────
cmd_install_cron() {
  log_info "Installing hourly crontab entry..."
  local cron_entry="0 * * * * ${HOME}/.local/bin/ai_cron-ai-agents-history run >/dev/null 2>&1"
  local current_cron
  current_cron=$(crontab -l 2>/dev/null || true)

  if echo "$current_cron" | grep -Fq "ai_cron-ai-agents-history"; then
    log_warn "Crontab entry already exists."
  else
    (echo "$current_cron"; echo "$cron_entry") | crontab -
    log_success "Hourly crontab entry added: $cron_entry"
  fi
}

# ── Command: uninstall ────────────────────────────────────────────────────────
cmd_uninstall() {
  log_info "Uninstalling AI history hourly schedules..."

  # Stop and disable systemd timer
  if systemctl --user is-active "$TIMER_NAME" >/dev/null 2>&1; then
    systemctl --user stop "$TIMER_NAME" 2>/dev/null || true
  fi
  if systemctl --user is-enabled "$TIMER_NAME" >/dev/null 2>&1; then
    systemctl --user disable "$TIMER_NAME" 2>/dev/null || true
  fi
  rm -f "${SYSTEMD_USER_DIR}/${TIMER_NAME}" "${SYSTEMD_USER_DIR}/${SERVICE_NAME}"
  systemctl --user daemon-reload 2>/dev/null || true
  log_success "Systemd timer and service removed."

  # Remove from crontab if present
  local current_cron
  current_cron=$(crontab -l 2>/dev/null || true)
  if echo "$current_cron" | grep -Fq "ai_cron-ai-agents-history"; then
    echo "$current_cron" | grep -Fv "ai_cron-ai-agents-history" | crontab - 2>/dev/null || crontab -r 2>/dev/null || true
    log_success "Removed crontab entry."
  fi
}

# ── Command: status ───────────────────────────────────────────────────────────
cmd_status() {
  echo -e "\n${BOLD}${CYAN}=== AI Agents History Hourly Cron Status ===${RESET}"
  
  # Check systemd user timer
  echo -e "\n${BOLD}Systemd User Timer ($TIMER_NAME):${RESET}"
  if systemctl --user is-active "$TIMER_NAME" >/dev/null 2>&1; then
    echo -e "  Status:  ${GREEN}${BOLD}Active (Running)${RESET}"
    systemctl --user list-timers "$TIMER_NAME" --no-pager 2>/dev/null | grep -E "NEXT|LEFT|$TIMER_NAME" || true
  else
    echo -e "  Status:  ${YELLOW}Inactive / Not running${RESET}"
  fi

  # Check Crontab
  echo -e "\n${BOLD}Crontab Schedule:${RESET}"
  local current_cron
  current_cron=$(crontab -l 2>/dev/null || true)
  if echo "$current_cron" | grep -Fq "ai_cron-ai-agents-history"; then
    echo -e "  Status:  ${GREEN}${BOLD}Active in crontab${RESET}"
    echo "$current_cron" | grep -F "ai_cron-ai-agents-history" | sed 's/^/    /'
  else
    echo -e "  Status:  ${DIM}Not installed in crontab${RESET}"
  fi

  # Check Log File
  echo -e "\n${BOLD}Recent Execution Log ($LOG_FILE):${RESET}"
  if [ -f "$LOG_FILE" ]; then
    tail -n 6 "$LOG_FILE" | sed 's/^/  /'
  else
    echo -e "  ${DIM}No execution logs found yet.${RESET}"
  fi
  echo
}

# ── Main Entrypoint ───────────────────────────────────────────────────────────
action="${1:-run}"

case "$action" in
  run)
    cmd_run
    ;;
  --status|status)
    cmd_status
    ;;
  --install|--install-timer|install)
    cmd_install_timer
    ;;
  --install-cron)
    cmd_install_cron
    ;;
  --uninstall|uninstall)
    cmd_uninstall
    ;;
  --help|-h)
    echo "Usage: ai_cron-ai-agents-history [run|--status|--install|--install-cron|--uninstall]"
    ;;
  *)
    log_error "Unknown option: $action"
    echo "Use --help for usage."
    exit 1
    ;;
esac
