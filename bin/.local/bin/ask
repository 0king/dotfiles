#!/usr/bin/env luajit
local ffi = require("ffi")
local cjson = require("cjson.safe")

if cjson.encode_empty_table_as_object then
    cjson.encode_empty_table_as_object(false)
end

ffi.cdef[[
    char *realpath(const char *path, char *resolved_path);
    void free(void *ptr);
    int getuid(void);
    int getpid(void);
]]

local MODEL = os.getenv("ASK_MODEL") or "lfm3:1.7b-qad-q4_0"
local NUM_CTX = tonumber(os.getenv("ASK_NUM_CTX")) or 8192
local NUM_THREAD = tonumber(os.getenv("ASK_NUM_THREAD")) or 2
local OLLAMA_URL = os.getenv("OLLAMA_HOST") or "http://127.0.0.1:11434"
if not OLLAMA_URL:match("^http") then OLLAMA_URL = "http://" .. OLLAMA_URL end
local CHAT_ENDPOINT = OLLAMA_URL:gsub("/+$", "") .. "/api/chat"

local HOME = os.getenv("HOME") or ""
local UID = tonumber(ffi.C.getuid())
local SESSION_FILE = string.format("/dev/shm/ask_session_%d.json", UID)

local CLI_MODEL = nil
local ENABLE_THINKING = (os.getenv("ASK_THINKING") ~= "0")
local SHOW_THINKING = (os.getenv("ASK_SHOW_THINKING") == "1")
local ENABLE_WEB_SEARCH = false
local INCLUDE_SKILLS = false

-- ============================================================================
-- 1. CONFIGURE SCOPES (MULTI-PATH ARRAYS & MULTI-ALIAS SUPPORT)
-- ============================================================================
local SCOPES = {
    notes = {
        name = "notes",
        aliases = { "-nn", "--nn", "-notes", "--notes", "@notes", "@nn", "nn", "notes" },
        description = "Personal notes and knowledge base",
        paths = {
            HOME .. "/Documents/Notes",
            HOME .. "/Documents/notes_secondary_placeholder",
        }
    },
    dotfiles = {
        name = "dotfiles",
        aliases = { "-df", "--df", "-dotfiles", "--dotfiles", "@dotfiles", "@df", "df", "dotfiles" },
        description = "Dotfiles repository",
        paths = {
            HOME .. "/dotfiles",
        }
    },
    configs = {
        name = "configs",
        aliases = { "-cfg", "--cfg", "-configs", "--configs", "@configs", "@cfg", "cfg", "config", "configs" },
        description = "System configurations",
        paths = {
            HOME .. "/.config",
        }
    },
    scripts = {
        name = "scripts",
        aliases = { "-bin", "--bin", "-scripts", "--scripts", "@scripts", "@bin", "bin", "scripts" },
        description = "Local binaries and scripts",
        paths = {
            HOME .. "/.local/bin",
        }
    },
    skills = {
        name = "skills",
        aliases = { "-fs", "--find-skills", "-skills", "--skills", "skills" },
        description = "AI Agent skills and guidelines",
        priority = false,
        paths = {
            HOME .. "/.config/ai/skills",
        }
    },
}

local FALLBACK_DIRS = {
    HOME .. "/Documents",
    HOME .. "/Desktop/projects",
}

-- ============================================================================
-- 2. SANDBOX, PATH RESOLUTION & SCOPE PINNING
-- ============================================================================
local function realpath(p)
    if not p or p == "" then return nil end
    if p:sub(1, 1) == "~" then p = HOME .. p:sub(2) end
    local ptr = ffi.C.realpath(p, nil)
    if ptr == nil then return nil end
    local res = ffi.string(ptr)
    ffi.C.free(ptr)
    return res
end

local ACTIVE_SCOPES = {}
local ALIAS_MAP = {}
local ALLOWED_ROOTS = {}
local PRIORITY_REALPATHS = {}

for scope_key, def in pairs(SCOPES) do
    local valid_paths = {}
    for _, raw_p in ipairs(def.paths) do
        local rp = realpath(raw_p)
        if rp then
            table.insert(valid_paths, rp)
            table.insert(ALLOWED_ROOTS, rp)
            if def.priority ~= false then
                table.insert(PRIORITY_REALPATHS, rp)
            end
        end
    end
    ACTIVE_SCOPES[scope_key] = valid_paths
    for _, alias in ipairs(def.aliases) do
        ALIAS_MAP[alias] = scope_key
    end
end

local ACTIVE_FALLBACK = {}
for _, raw_p in ipairs(FALLBACK_DIRS) do
    local rp = realpath(raw_p)
    if rp then
        table.insert(ACTIVE_FALLBACK, rp)
        table.insert(ALLOWED_ROOTS, rp)
    end
end

local EXCLUDED_ROOTS = {}
local function add_excluded_root(raw_p)
    local rp = realpath(raw_p)
    if rp then table.insert(EXCLUDED_ROOTS, rp) end
end
add_excluded_root(HOME .. "/.config/ai/skills")
add_excluded_root(HOME .. "/dotfiles/ai/.config/ai/skills")

local function is_excluded_path(rp)
    if INCLUDE_SKILLS then return false end
    if not rp then return true end
    for _, excl in ipairs(EXCLUDED_ROOTS) do
        if rp == excl or rp:sub(1, #excl + 1) == excl .. "/" then
            return true
        end
    end
    return false
end

local function is_safe_path(rp)
    if not rp or is_excluded_path(rp) then return false end
    for _, root in ipairs(ALLOWED_ROOTS) do
        if rp == root or rp:sub(1, #root + 1) == root .. "/" then
            return true
        end
    end
    return false
end

-- Matches a token against known aliases or subpaths (e.g. "-df", "--nn", "-df/zsh")
local function parse_scope_token(token)
    if not token or token == "" then return nil end
    if ALIAS_MAP[token] then
        return ALIAS_MAP[token], nil, token
    end
    for alias, scope_key in pairs(ALIAS_MAP) do
        if token:sub(1, #alias + 1) == alias .. "/" then
            local sub = token:sub(#alias + 2):gsub("^/+", "")
            return scope_key, sub, alias
        end
    end
    return nil
end

local function resolve_scope_paths(scope_key, subpath)
    local bases = ACTIVE_SCOPES[scope_key] or {}
    if not subpath or subpath == "" then
        return bases
    end
    local resolved = {}
    for _, base in ipairs(bases) do
        local cand = base .. "/" .. subpath
        local rp = realpath(cand)
        if rp and is_safe_path(rp) then
            table.insert(resolved, rp)
        end
    end
    return resolved
end

-- Global scope pinning state
local PINNED_SCOPE = nil
local PINNED_LABEL = nil
local PINNED_SUBPATH = nil
local PINNED_PATHS = nil

local function resolve_tiers(target, scope)
    target = (target or "."):match("^%s*(.-)%s*$")
    if target:find(":") then
        local post = target:match(":(.+)$")
        if post and post ~= "" then target = post:match("^%s*(.-)%s*$") end
    end

    -- 1. Default / auto target
    if target == "" or target == "." or target == "auto" or target == PINNED_LABEL then
        if PINNED_PATHS and #PINNED_PATHS > 0 then
            return { PINNED_PATHS }
        end
        if scope == "all" then
            local combined = {}
            for _, p in ipairs(PRIORITY_REALPATHS) do table.insert(combined, p) end
            for _, p in ipairs(ACTIVE_FALLBACK) do table.insert(combined, p) end
            return { combined }
        end
        local tiers = {}
        if #PRIORITY_REALPATHS > 0 then table.insert(tiers, PRIORITY_REALPATHS) end
        if #ACTIVE_FALLBACK > 0 then table.insert(tiers, ACTIVE_FALLBACK) end
        return tiers
    end

    -- 2. Direct alias / subpath resolution (e.g. "-df", "-df/zsh", "--nn")
    local sk, sub = parse_scope_token(target)
    if sk then
        local sp_paths = resolve_scope_paths(sk, sub)
        if #sp_paths > 0 then return { sp_paths } end
        return nil, "Scope or subpath not found: " .. target
    end

    -- 3. Specific path (relative or absolute) inside allowed roots
    local clean_sub = target:gsub("^[%-%.]+", "")
    local candidates = { target }
    if clean_sub ~= "" and clean_sub ~= target then
        table.insert(candidates, clean_sub)
    end
    if PINNED_PATHS then
        for _, p in ipairs(PINNED_PATHS) do
            table.insert(candidates, 1, p .. "/" .. target)
            if clean_sub ~= "" and clean_sub ~= target then
                table.insert(candidates, 1, p .. "/" .. clean_sub)
            end
        end
    end
    for _, root in ipairs(ALLOWED_ROOTS) do
        table.insert(candidates, root .. "/" .. target)
        if clean_sub ~= "" and clean_sub ~= target then
            table.insert(candidates, root .. "/" .. clean_sub)
        end
    end
    for _, cand in ipairs(candidates) do
        local rp = realpath(cand)
        if rp and is_safe_path(rp) then
            return { { rp } }
        end
    end

    -- 4. If PINNED_PATHS is active and nothing resolved, fallback to PINNED_PATHS for searches
    if PINNED_PATHS and #PINNED_PATHS > 0 then
        return { PINNED_PATHS }
    end

    return nil, "Access denied or path not found: " .. target
end

local function sh_quote(s)
    s = tostring(s or ""):gsub("%z", "")
    return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function shorten_paths(text)
    for _, def in pairs(SCOPES) do
        local primary_alias = def.aliases[1]
        local valid = ACTIVE_SCOPES[def.name] or {}
        for _, rp in ipairs(valid) do
            text = text:gsub(rp:gsub("(%W)", "%%%1"), primary_alias)
        end
    end
    if HOME ~= "" then
        text = text:gsub(HOME:gsub("(%W)", "%%%1"), "~")
    end
    return text
end

local function run_sandboxed_cmd(cmd, timeout_sec)
    local t = tonumber(timeout_sec) or 10
    local full_cmd = string.format("timeout %ds %s </dev/null 2>/dev/null", t, cmd)
    local h = io.popen(full_cmd, "r")
    if not h then return "" end
    local out = h:read("*a") or ""
    h:close()
    return out:match("^%s*(.-)%s*$")
end

-- ============================================================================
-- 3. THREE BOUNDED LOCAL TOOLS (find_files, grep_files, read_file_lines)
-- ============================================================================
local function find_files(args)
    local raw_pattern = tostring(args.pattern or ""):match("^%s*(.-)%s*$")
    local tiers, err = resolve_tiers(args.target or ".", args.scope or "priority_first")
    if not tiers then return "Error: " .. err end

    local fd_bin = os.execute("command -v fd >/dev/null 2>&1") == 0 and "fd" or "fdfind"
    local excl_skills = not INCLUDE_SKILLS and "--exclude 'ai/skills' --exclude '.config/ai/skills' " or ""
    for idx, paths in ipairs(tiers) do
        local cmd = { fd_bin .. " -H --exclude .git " .. excl_skills .. "--type f --max-results 120" }
        for _, p in ipairs(paths) do
            table.insert(cmd, "--search-path " .. sh_quote(p))
        end
        if raw_pattern ~= "" and raw_pattern ~= "." and raw_pattern ~= "*" and raw_pattern ~= ".*" then
            if raw_pattern:find("[*?]") then
                table.insert(cmd, "--glob -- " .. sh_quote(raw_pattern))
            else
                table.insert(cmd, "-- " .. sh_quote(raw_pattern))
            end
        end
        local out = run_sandboxed_cmd(table.concat(cmd, " "), 10)
        if out ~= "" then
            local lines = {}
            for line in out:gmatch("[^\r\n]+") do table.insert(lines, line) end
            local label = PINNED_LABEL and ("[" .. PINNED_LABEL .. "]\n")
                or ((idx == 1 and #tiers > 1) and "[Priority Scopes]\n" or "[Fallback Scopes]\n")
            local count_header = string.format("[Found %d matching file%s]\n", #lines, #lines == 1 and "" or "s")
            return label .. count_header .. shorten_paths(out)
        end
    end
    return "No files matching '" .. raw_pattern .. "' found."
end

local function grep_files(args)
    local query = tostring(args.query or "")
    if query == "" then return "Error: empty query" end
    local tiers, err = resolve_tiers(args.target or ".", args.scope or "priority_first")
    if not tiers then return "Error: " .. err end

    -- Allow anchored queries to match indented lines in blocks
    local rg_query = query:gsub("^%^([%a_]+)", "^\\s*%1")

    local rg_excl = not INCLUDE_SKILLS and "-g '!**/ai/skills/**' -g '!**/.config/ai/skills/**' " or ""
    local max_lines = 150
    for idx, paths in ipairs(tiers) do
        local cmd = {
            "rg --hidden -g '!.git/*' " .. rg_excl .. "-n --smart-case --max-columns 500 --max-columns-preview",
            "-e " .. sh_quote(rg_query),
            "--"
        }
        for _, p in ipairs(paths) do table.insert(cmd, sh_quote(p)) end
        local out = run_sandboxed_cmd(table.concat(cmd, " "), 10)
        if out ~= "" then
            local lines = {}
            for line in out:gmatch("[^\r\n]+") do table.insert(lines, line) end

            local active_count = 0
            local comment_count = 0
            local unique_defs = {}
            local def_type = nil

            for _, line in ipairs(lines) do
                local content = line:match(":%d+:(.*)$") or line:match("^%d+:(.*)$") or line
                local trimmed = content:match("^%s*(.-)%s*$")
                if trimmed:match("^[#]") or trimmed:match("^//") or trimmed:match("^%-%-") then
                    comment_count = comment_count + 1
                else
                    active_count = active_count + 1
                    local a_name = trimmed:match("^alias%s+%-g%s+[%'\"]?([%w_%-%.:]+)[%'\"]?%s*=")
                        or trimmed:match("^alias%s+[%'\"]?([%w_%-%.:]+)[%'\"]?%s*=")
                    if a_name then
                        def_type = "alias"
                        unique_defs[a_name] = true
                    else
                        local e_name = trimmed:match("^export%s+([%w_]+)%s*=")
                        if e_name then
                            def_type = "export"
                            unique_defs[e_name] = true
                        else
                            local f_name = trimmed:match("^function%s+([%w_%-:]+)%s*%(")
                                or trimmed:match("^([%w_%-:]+)%s*%(%s*%)%s*{")
                            if f_name then
                                def_type = "function"
                                unique_defs[f_name] = true
                            end
                        end
                    end
                end
            end

            local unique_count = 0
            for _ in pairs(unique_defs) do unique_count = unique_count + 1 end

            local count_header
            if def_type and unique_count > 0 and unique_count ~= #lines then
                count_header = string.format("[Found %d unique %s names across %d active lines (%d commented, %d total matching lines)]\n",
                    unique_count, def_type, active_count, comment_count, #lines)
            elseif comment_count > 0 then
                count_header = string.format("[Found %d matching lines: %d active, %d commented]\n",
                    #lines, active_count, comment_count)
            else
                count_header = string.format("[Found %d matching line%s]\n", #lines, #lines == 1 and "" or "s")
            end

            local sliced = {}
            for i = 1, math.min(max_lines, #lines) do table.insert(sliced, lines[i]) end
            local label = PINNED_LABEL and ("[" .. PINNED_LABEL .. "]\n")
                or ((idx == 1 and #tiers > 1) and "[Priority Scopes]\n" or "[Fallback Scopes]\n")
            local res = label .. count_header .. shorten_paths(table.concat(sliced, "\n"))
            if #lines > max_lines then
                res = res .. string.format("\n... (%d more matches omitted)", #lines - max_lines)
            end
            return res
        end
    end
    return "No matches found for '" .. query .. "'."
end

local function read_file_lines(args)
    local target = tostring(args.file_path or ""):match("^%s*(.-)%s*$")
    if target == "" then return "Error: empty file_path" end
    if target:find(":") then
        local post = target:match(":(.+)$")
        if post and post ~= "" then target = post:match("^%s*(.-)%s*$") end
    end

    local clean_sub = target:gsub("^[%-%.]+", "")
    local candidates = { target }
    if clean_sub ~= "" and clean_sub ~= target then
        table.insert(candidates, clean_sub)
    end
    if PINNED_PATHS then
        for _, p in ipairs(PINNED_PATHS) do
            table.insert(candidates, 1, p .. "/" .. target)
            if clean_sub ~= "" and clean_sub ~= target then
                table.insert(candidates, 1, p .. "/" .. clean_sub)
            end
        end
    end
    for _, root in ipairs(ALLOWED_ROOTS) do
        table.insert(candidates, root .. "/" .. target)
        if clean_sub ~= "" and clean_sub ~= target then
            table.insert(candidates, root .. "/" .. clean_sub)
        end
    end

    local full_path = nil
    for _, cand in ipairs(candidates) do
        local rp = realpath(cand)
        if rp and is_safe_path(rp) then
            full_path = rp
            break
        end
    end

    if not full_path then
        local sk, sub = parse_scope_token(target)
        if sk and sub then
            local sp_paths = resolve_scope_paths(sk, sub)
            if #sp_paths > 0 then full_path = sp_paths[1] end
        end
    end

    if not full_path and PINNED_PATHS then
        local stripped = target:gsub("^[%-%.%w]+/", "")
        for _, p in ipairs(PINNED_PATHS) do
            local rp = realpath(p .. "/" .. stripped)
            if rp and is_safe_path(rp) then
                full_path = rp
                break
            end
        end
    end

    if not full_path then
        return "Error: File not found or access denied: " .. target
    end

    local is_dir = os.execute(string.format("test -d %s >/dev/null 2>&1", sh_quote(full_path))) == 0
    if is_dir then
        return "Error: '" .. full_path .. "' is a directory, not a readable file. Use find_files to explore files inside it."
    end

    local s_line = math.max(1, tonumber(args.start_line) or 1)
    local e_line = math.min(s_line + 200, tonumber(args.end_line) or (s_line + 100))

    local f, open_err = io.open(full_path, "r")
    if not f then return "Error opening file: " .. tostring(open_err) end

    local out = {}
    local curr = 0
    for line in f:lines() do
        curr = curr + 1
        if curr >= s_line and curr <= e_line then
            if #line > 1000 then line = line:sub(1, 1000) .. "... [truncated]" end
            table.insert(out, string.format("%d: %s", curr, line))
        elseif curr > e_line then
            break
        end
    end
    f:close()
    return #out > 0 and table.concat(out, "\n") or "EOF or empty line range."
end

local function web_search(args)
    local query = tostring(args.query or "")
    if query == "" then return "Error: empty search query" end
    local raw = run_sandboxed_cmd("ddgr --json --np -n 4 -- " .. sh_quote(query), 8)
    if raw ~= "" then
        local results = cjson.decode(raw)
        if type(results) == "table" and #results > 0 then
            local formatted = {}
            for _, r in ipairs(results) do
                table.insert(formatted, string.format(
                    "Title: %s\nURL: %s\nSnippet: %s",
                    tostring(r.title or ""), tostring(r.url or ""), tostring(r.abstract or "")
                ))
            end
            return table.concat(formatted, "\n\n")
        end
    end
    return "No web results returned for '" .. query .. "'."
end

local TOOL_MAP = {
    find_files = find_files,
    grep_files = grep_files,
    read_file_lines = read_file_lines,
    web_search = web_search,
}

local BASE_TOOLS_SCHEMA = {
    {
        type = "function",
        ["function"] = {
            name = "grep_files",
            description = "Search file contents by regex or keyword across files.",
            parameters = {
                type = "object",
                properties = {
                    query = { type = "string", description = "Keyword or regex pattern to search for (e.g. 'alias ')" },
                    target = { type = "string", description = "Subdirectory, file path, or '.' (e.g. 'zsh', 'wezterm', '.')" }
                },
                required = { "query" }
            }
        }
    },
    {
        type = "function",
        ["function"] = {
            name = "find_files",
            description = "Find file paths by filename glob or substring.",
            parameters = {
                type = "object",
                properties = {
                    pattern = { type = "string", description = "Filename pattern or glob (e.g. '*alias*', '*.zsh', 'kitty.conf')" },
                    target = { type = "string", description = "Subdirectory or '.' (e.g. 'zsh', '.')" }
                },
                required = { "pattern" }
            }
        }
    },
    {
        type = "function",
        ["function"] = {
            name = "read_file_lines",
            description = "Read a specific line range from a file.",
            parameters = {
                type = "object",
                properties = {
                    file_path = { type = "string", description = "File path to inspect" },
                    start_line = { type = "integer", description = "Start line (1-indexed)" },
                    end_line = { type = "integer", description = "End line" }
                },
                required = { "file_path" }
            }
        }
    }
}

local WEB_SEARCH_SCHEMA = {
    type = "function",
    ["function"] = {
        name = "web_search",
        description = "Search web via DuckDuckGo.",
        parameters = {
            type = "object",
            properties = { query = { type = "string" } },
            required = { "query" }
        }
    }
}

local function get_active_tools_schema()
    local tools = {}
    for _, t in ipairs(BASE_TOOLS_SCHEMA) do
        table.insert(tools, t)
    end
    if ENABLE_WEB_SEARCH then
        table.insert(tools, WEB_SEARCH_SCHEMA)
    end
    return tools
end

-- ============================================================================
-- 4. OLLAMA IPC & /dev/shm SESSION MANAGEMENT
-- ============================================================================
local function clean_text(text)
    if not text then return "" end
    text = text:gsub("<thought>.-</thought>", "")
    text = text:gsub("<think>.-</think>", "")
    return text:match("^%s*(.-)%s*$") or ""
end

local function extract_thinking(msg)
    if not msg then return nil end
    if msg.thinking and msg.thinking:match("%S") then
        return msg.thinking
    end
    if msg.content then
        local t = msg.content:match("<thought>(.-)</thought>") or msg.content:match("<think>(.-)</think>")
        if t and t:match("%S") then
            return t
        end
    end
    return nil
end

local function print_thinking(msg)
    if not SHOW_THINKING then return end
    local t = extract_thinking(msg)
    if t then
        local trimmed = t:match("^%s*(.-)%s*$")
        if trimmed and trimmed ~= "" then
            print(string.format("\27[90m--- Thinking ---\n%s\n----------------\27[0m\n", trimmed))
        end
    end
end

local function ollama_chat(messages, no_tools, max_predict, force_think)
    local tmp_req = string.format("/dev/shm/ask_req_%d_%d.json", UID, tonumber(ffi.C.getpid()))
    local default_predict = tonumber(os.getenv("ASK_NUM_PREDICT")) or (ENABLE_THINKING and 1536 or 512)
    local will_think = ENABLE_THINKING
    if force_think ~= nil then will_think = force_think end
    local req_payload = {
        model = MODEL,
        messages = messages,
        think = will_think,
        options = {
            num_ctx = NUM_CTX,
            num_predict = max_predict or default_predict,
            temperature = 0.0,
            num_thread = NUM_THREAD,
            num_gpu = 999
        },
        stream = false
    }
    if not no_tools then
        req_payload.tools = get_active_tools_schema()
    end
    local payload = cjson.encode(req_payload)
    local f = io.open(tmp_req, "w")
    f:write(payload)
    f:close()

    local timeout_sec = ENABLE_THINKING and 300 or 90
    local cmd = string.format(
        "curl -s --max-time %d -X POST %s -H 'Content-Type: application/json' -d @%s",
        timeout_sec, sh_quote(CHAT_ENDPOINT), sh_quote(tmp_req)
    )
    local h = io.popen(cmd, "r")
    local raw = h and h:read("*a") or ""
    if h then h:close() end
    os.remove(tmp_req)

    if not raw or raw == "" then
        io.stderr:write("Ollama error: Connection timed out or empty response\n")
        os.exit(1)
    end

    local res, err = cjson.decode(raw)
    if not res or not res.message then
        io.stderr:write("Ollama error: " .. tostring(err or raw) .. "\n")
        os.exit(1)
    end
    return res.message
end

local function load_session()
    local f = io.open(SESSION_FILE, "r")
    if not f then return nil end
    local data = cjson.decode(f:read("*a"))
    f:close()
    return data
end

local function save_session(messages)
    local f = io.open(SESSION_FILE, "w")
    if f then
        f:write(cjson.encode({
            pinned_scope = PINNED_SCOPE,
            pinned_label = PINNED_LABEL,
            pinned_subpath = PINNED_SUBPATH,
            model = MODEL,
            messages = messages
        }))
        f:close()
    end
end

local function is_monologue(text)
    if not text or text == "" then return false end
    local lower = text:lower()
    local patterns = {
        "the user asks",
        "the user is asking",
        "we need to",
        "we should",
        "let me ",
        "let's ",
        "the previous grep",
        "the previous search",
        "i need to",
        "i should",
        "i will ",
        "i'll ",
    }
    for _, pat in ipairs(patterns) do
        if lower:find(pat, 1, true) then
            return true
        end
    end
    return false
end

local function has_tool_results(messages)
    for _, m in ipairs(messages) do
        if m.role == "tool" then return true end
    end
    return false
end

local function synthesize_answer(messages)
    local flat_messages = {}
    for _, m in ipairs(messages) do
        if m.role == "system" then
            table.insert(flat_messages, { role = "system", content = m.content })
        elseif m.role == "user" then
            table.insert(flat_messages, { role = "user", content = m.content })
        elseif m.role == "assistant" then
            if m.tool_calls and #m.tool_calls > 0 then
                local call_descs = {}
                for _, c in ipairs(m.tool_calls) do
                    local fn = c["function"].name
                    local fargs = c["function"].arguments
                    if type(fargs) == "table" then fargs = cjson.encode(fargs) end
                    table.insert(call_descs, string.format("[%s(%s)]", fn, tostring(fargs)))
                end
                table.insert(flat_messages, { role = "assistant", content = table.concat(call_descs, "\n") })
            elseif m.content and m.content ~= "" and not is_monologue(m.content) then
                table.insert(flat_messages, { role = "assistant", content = m.content })
            end
        elseif m.role == "tool" then
            table.insert(flat_messages, { role = "user", content = string.format("[Tool Result from %s]:\n%s", m.name or "tool", m.content or "") })
        end
    end
    table.insert(flat_messages, {
        role = "user",
        content = "Based on the tool results above, provide an accurate, complete, and factually verified answer. Cite relevant file paths and line numbers (path:line), quote the exact configuration or code where applicable, and explain key details clearly. Rely on tool summary headers for any counts or totals. Avoid preamble or filler."
    })
    io.stderr:write("\27[90m  -> Synthesizing verified answer...\27[0m\n")
    local synth = ollama_chat(flat_messages, true, 1536, false)
    print_thinking(synth)
    local ans = clean_text(synth and synth.content)
    if ans == "" and synth and synth.thinking then
        ans = clean_text(synth.thinking)
    end
    return ans
end

local function run_turn(messages, user_query)
    local prompt = user_query
    if PINNED_LABEL and PINNED_PATHS and #PINNED_PATHS > 0 then
        prompt = string.format("[Scope locked to %s: %s] %s", PINNED_LABEL, table.concat(PINNED_PATHS, ", "), user_query)
    end

    table.insert(messages, { role = "user", content = prompt })

    local seen_sigs = {}
    for turn = 1, 5 do
        local msg = ollama_chat(messages, false)
        table.insert(messages, msg)

        print_thinking(msg)

        local content_clean = clean_text(msg.content)
        if msg.tool_calls and #msg.tool_calls > 0 then
            local call_parts = {}
            for _, call in ipairs(msg.tool_calls) do
                local fn = call["function"].name
                local fargs = call["function"].arguments
                if type(fargs) == "string" then fargs = cjson.decode(fargs) or {} end
                local q = (fargs.query or fargs.pattern or ""):gsub("^%^%s*", ""):gsub("%s+$", "")
                local tgt = fargs.target or fargs.file_path or ""
                table.insert(call_parts, string.format("%s:%s:%s", fn, q, tgt))
            end
            local current_sig = table.concat(call_parts, ";")
            if seen_sigs[current_sig] then
                -- Redundant loop detected: break to synthesize answer
                break
            end
            seen_sigs[current_sig] = true

            for _, call in ipairs(msg.tool_calls) do
                local fn = call["function"].name
                local fargs = call["function"].arguments
                if type(fargs) == "string" then fargs = cjson.decode(fargs) or {} end
                io.stderr:write(string.format("\27[90m  -> %s(%s)\27[0m\n", fn, cjson.encode(fargs)))
                local out = TOOL_MAP[fn] and TOOL_MAP[fn](fargs) or ("Unknown tool: " .. tostring(fn))
                table.insert(messages, { role = "tool", name = fn, content = out })
            end
        else
            -- No tool calls returned by model
            if content_clean ~= "" and not is_monologue(content_clean) then
                print(shorten_paths(content_clean))
                save_session(messages)
                return
            elseif has_tool_results(messages) then
                -- Model produced monologue or empty content with tool results available: synthesize
                local ans = synthesize_answer(messages)
                if ans and ans ~= "" and not is_monologue(ans) then
                    print(shorten_paths(ans))
                    table.insert(messages, { role = "assistant", content = ans })
                    save_session(messages)
                    return
                end
            elseif turn < 5 then
                -- Model produced monologue without tool calls and without tool results yet; nudge
                table.insert(messages, {
                    role = "user",
                    content = "Please execute the tool call (find_files, grep_files, or read_file_lines) using the provided tools now."
                })
            end
        end
    end

    -- Loop ended or redundant loop broke: synthesize final response
    local ans = synthesize_answer(messages)
    if ans and ans ~= "" then
        print(shorten_paths(ans))
        table.insert(messages, { role = "assistant", content = ans })
        save_session(messages)
    end
end

-- ============================================================================
-- 5. FLEXIBLE CLI PARSER (Unquoted queries + Scope Flags + -c / -i / -llm)
-- ============================================================================
local mode = "oneshot"
local query_parts = {}
local parsing_flags = true
local i = 1

while i <= #arg do
    local token = arg[i]
    if parsing_flags and (token == "-c" or token == "--continue") then
        mode = "continue"
    elseif parsing_flags and (token == "-i" or token == "--interactive") then
        mode = "interactive"
    elseif parsing_flags and (token == "-t" or token == "--think") then
        ENABLE_THINKING = true
    elseif parsing_flags and (token == "-nt" or token == "--no-think" or token == "--no-t") then
        ENABLE_THINKING = false
    elseif parsing_flags and (token == "-st" or token == "--show-thinking") then
        ENABLE_THINKING = true
        SHOW_THINKING = true
    elseif parsing_flags and (token == "-w" or token == "--web" or token == "--web-search") then
        ENABLE_WEB_SEARCH = true
    elseif parsing_flags and (token == "-fs" or token == "--find-skills") and PINNED_SCOPE then
        INCLUDE_SKILLS = true
    elseif parsing_flags and (token == "-llm" or token == "--llm") then
        i = i + 1
        if i <= #arg then
            CLI_MODEL = arg[i]
            MODEL = CLI_MODEL
        else
            io.stderr:write("\27[31mError: -llm requires a model name argument\27[0m\n")
            os.exit(1)
        end
    elseif parsing_flags and (token:match("^%-llm=(.+)") or token:match("^%-%-llm=(.+)")) then
        CLI_MODEL = token:match("^%-%-?llm=(.+)")
        MODEL = CLI_MODEL
    elseif parsing_flags and parse_scope_token(token) then
        local sk, sub = parse_scope_token(token)
        if sk == "skills" then
            INCLUDE_SKILLS = true
        end
        local paths = resolve_scope_paths(sk, sub)
        if #paths == 0 then
            io.stderr:write(string.format("\27[31mError: Scope '%s' (%s) path does not exist on disk.\27[0m\n", sk, token))
            os.exit(1)
        end
        PINNED_SCOPE = sk
        PINNED_LABEL = token
        PINNED_SUBPATH = sub
        PINNED_PATHS = paths
    else
        parsing_flags = false
        table.insert(query_parts, token)
    end
    i = i + 1
end

local SYS_INSTRUCTIONS = [[You are an accurate, technical CLI file assistant.
Rules:
1. Use `find_files` to discover paths and `grep_files` to search contents. When you locate a candidate file or setting, use `read_file_lines` to inspect surrounding context to confirm how the setting or logic is defined before concluding.
2. Rely on tool outputs and summary headers for counts or totals; do not recount lines manually or guess.
3. Provide an accurate, complete, and factually grounded answer. Cite exact paths and line numbers (`path:line`), show the exact configuration or code snippets, and explain relevant context clearly. Avoid unnecessary conversational fluff or pleasantries.]]

local active_summary = {}
for _, def in pairs(SCOPES) do
    local v = ACTIVE_SCOPES[def.name] or {}
    if #v > 0 then
        table.insert(active_summary, def.aliases[1] .. "=" .. table.concat(v, ";"))
    end
end
local sys_context = SYS_INSTRUCTIONS .. "\n\nAvailable scopes: " .. table.concat(active_summary, ", ")

local messages = nil
if mode == "continue" then
    local saved = load_session()
    if saved and saved.messages then
        messages = saved.messages
        if not CLI_MODEL and saved.model then
            MODEL = saved.model
        end
        if not PINNED_SCOPE and saved.pinned_scope then
            PINNED_SCOPE = saved.pinned_scope
            PINNED_LABEL = saved.pinned_label
            PINNED_SUBPATH = saved.pinned_subpath
            PINNED_PATHS = resolve_scope_paths(PINNED_SCOPE, PINNED_SUBPATH)
        end
    else
        io.stderr:write("\27[33m[No prior session in /dev/shm; starting fresh]\27[0m\n")
    end
end

if not messages then
    messages = { { role = "system", content = sys_context } }
end

local initial_query = table.concat(query_parts, " ")
if initial_query ~= "" then
    run_turn(messages, initial_query)
elseif mode ~= "interactive" then
    io.stderr:write("Usage:\n  ask [flags] <query>\n\nFlags:\n  -llm, --llm <model>  Switch Ollama model for query (e.g. lfm3:1.7b-qad-q4_0, lfm3-agent)\n  -fs, --find-skills   Search and include AI agent skills in ~/.config/ai/skills\n  -t, --think          Enable model thinking / reasoning (enabled by default)\n  -nt, --no-think      Disable model thinking / reasoning for low-latency one-liners\n  -st, --show-thinking Show reasoning process in dimmed text before answer\n  -w, --web            Enable DuckDuckGo web search via ddgr (aliases: --web, --web-search)\n  -c, --continue       Continue previous session from /dev/shm\n  -i, --interactive    Drop into interactive multi-turn session\n  -df, -nn, ...        Scope pinning flags (-df=dotfiles, -nn=notes, etc.)\n\nExamples:\n  ask where is wezterm config?\n  ask -df where are my aliases?\n  ask -llm lfm3-agent -df where are my aliases?\n  ask -fs what skills are available for testing?\n  ask -fs find test-driven-development skill\n  ask -fs/git-workflow what are the commit guidelines?\n  ask -st how many r's are in strawberry?\n  ask -nt quick check for my tmux prefix\n  ask -w what are latest features in lua 5.4?\n  ask -df explain how my aliases are organized\n  ask -c what was the last line of that file?\n")
    os.exit(1)
end

if mode == "interactive" then
    while true do
        local prompt_label = PINNED_LABEL and ("Follow-up (" .. PINNED_LABEL .. ") > ") or "Follow-up > "
        io.write("\n\27[36m" .. prompt_label .. "\27[0m")
        io.flush()
        local line = io.read("*l")
        if not line or line == "q" or line == "exit" or line == "" then break end
        run_turn(messages, line)
    end
end
